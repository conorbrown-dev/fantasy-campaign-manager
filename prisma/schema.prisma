generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CampaignTheme {
  PURPLE_LILAC
  MINT_YELLOW
  PINK_GRAY
  DM_FORGE
}

enum QuestStatus {
  PLANNED
  ACTIVE
  COMPLETED
  FAILED
}

enum EncounterStatus {
  DRAFT
  PENDING
  ACTIVE
  ARCHIVED
}

enum CampaignNoteType {
  STORY_POINT
  IMPORTANT_EVENT
  COMBAT_ENCOUNTER
  NONCOMBAT_ENCOUNTER
  LOOT_GEAR
  NPC_NOTE
  LOCATION_DETAIL
}

enum CampaignNoteAttachmentType {
  LOOT_GEAR
  NPC
  STORY_POINT
  IMPORTANT_EVENT
  COMBAT_ENCOUNTER
  NONCOMBAT_ENCOUNTER
}

enum CampaignNoteTriggerType {
  ROLL_CHECK
  PLAYER_ACTION
  LOCATION_ENTRY
  ITEM_POSSESSION
  STORY_FLAG
  TIME_ELAPSED
  DM_DECISION
}

enum KnowledgeSourceType {
  SRD
  Open5e
  FiveEBits
  Homebrew
  SessionNotes
  CustomMonster
  CustomSpell
  HouseRule
}

enum KnowledgeDocumentStatus {
  IMPORTED
  CHUNKED
  INDEXED
  FAILED
}

enum KnowledgeChunkIndexStatus {
  PENDING
  INDEXED
  FAILED
}

model Campaign {
  id                        String                  @id @default(cuid())
  slug                      String                  @unique
  name                      String
  dmPasswordHash            String
  theme                     CampaignTheme           @default(PURPLE_LILAC)
  currentBgmAssetId         String?
  currentCampaignMapAssetId String?
  currentStoryImageAssetId  String?
  playerMapVisible          Boolean                 @default(true)
  storyImageVisible         Boolean                 @default(false)
  allowPlayerTheme          Boolean                 @default(false)
  bgmStartedAt              DateTime?
  campaignMapSetAt          DateTime?
  storyImageSetAt           DateTime?
  createdAt                 DateTime                @default(now())
  updatedAt                 DateTime                @updatedAt
  players                   Player[]
  quests                    Quest[]
  encounters                Encounter[]
  assets                    Asset[]
  mapPins                   MapPin[]
  locations                 CampaignLocation[]
  campaignNotes             CampaignNote[]
  knowledgeDocuments        KnowledgeDocument[]
  knowledgeChunks           KnowledgeChunk[]
  monsterManualDocuments    MonsterManualDocument[]
  monsterCatalogEntries     MonsterCatalogEntry[]
  bgmPlaylists              BgmPlaylist[]
}

model Player {
  id                      String                   @id @default(cuid())
  campaignId              String
  name                    String
  accessCodeHash          String?
  iconUrl                 String?
  theme                   CampaignTheme?
  stats                   Json
  equipment               Json
  money                   Json
  rolls                   Json
  abilities               Json
  archivedAt              DateTime?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  campaign                Campaign                 @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignNotes           CampaignNotePlayer[]
  characterSheetRevisions CharacterSheetRevision[]
  campaignNoteTriggers    CampaignNoteTrigger[]
}

model Quest {
  id         String      @id @default(cuid())
  campaignId String
  parentId   String?
  title      String
  summary    String
  status     QuestStatus @default(PLANNED)
  loot       Loot[]
  campaign   Campaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  parent     Quest?      @relation("SubQuests", fields: [parentId], references: [id])
  subQuests  Quest[]     @relation("SubQuests")
}

model Loot {
  id       String  @id @default(cuid())
  questId  String
  name     String
  quantity Int     @default(1)
  notes    String?
  quest    Quest   @relation(fields: [questId], references: [id], onDelete: Cascade)
}

model Creature {
  id                   String              @id @default(cuid())
  name                 String
  imageUrl             String?
  preferredEnvironment String
  armorClass           Int?
  hitPoints            Int?
  attackInfo           Json
  rolls                Json
  notes                String?
  encounterCreatures   EncounterCreature[]
}

model MonsterManualDocument {
  id               String                @id @default(cuid())
  campaignId       String
  title            String
  originalFileName String
  mimeType         String?
  contentHash      String
  importedAt       DateTime              @default(now())
  status           String                @default("IMPORTED")
  errorMessage     String?
  pageCount        Int                   @default(0)
  entryCount       Int                   @default(0)
  campaign         Campaign              @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  entries          MonsterCatalogEntry[]

  @@unique([campaignId, contentHash])
  @@index([campaignId, importedAt])
}

model MonsterCatalogEntry {
  id              String                @id @default(cuid())
  campaignId      String
  documentId      String
  creatureId      String?
  name            String
  pageNumber      Int
  pageImageUrl    String
  sizeType        String?
  armorClass      Int?
  hitPoints       Int?
  challengeRating String?
  sourceText      String
  searchText      String
  createdAt       DateTime              @default(now())
  campaign        Campaign              @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  document        MonsterManualDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([campaignId, name])
  @@index([campaignId, pageNumber])
  @@index([documentId])
}

model Encounter {
  id         String              @id @default(cuid())
  campaignId String
  name       String
  status     EncounterStatus     @default(DRAFT)
  mapAssetId String?
  ruleNotes  Json
  creatures  EncounterCreature[]
  campaign   Campaign            @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}

model EncounterCreature {
  id           String    @id @default(cuid())
  encounterId  String
  creatureId   String
  nickname     String?
  armorClass   Int?
  maxHitPoints Int?
  currentHp    Int?
  speed        Int?
  initiative   Int?
  strength     Int?
  dexterity    Int?
  constitution Int?
  intelligence Int?
  wisdom       Int?
  charisma     Int?
  keyItems     String[]  @default([])
  encounter    Encounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  creature     Creature  @relation(fields: [creatureId], references: [id], onDelete: Restrict)
}

model Asset {
  id            String       @id @default(cuid())
  campaignId    String
  bgmPlaylistId String?
  kind          String
  name          String
  url           String
  mimeType      String
  sortOrder     Int          @default(0)
  createdAt     DateTime     @default(now())
  campaign      Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  bgmPlaylist   BgmPlaylist? @relation(fields: [bgmPlaylistId], references: [id], onDelete: SetNull)

  @@index([bgmPlaylistId, sortOrder])
}

model BgmPlaylist {
  id         String   @id @default(cuid())
  campaignId String
  name       String
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  tracks     Asset[]

  @@unique([campaignId, name])
  @@index([campaignId, sortOrder])
}

model MapPin {
  id         String   @id @default(cuid())
  campaignId String
  label      String
  iconUrl    String?
  x          Float
  y          Float
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}

model CampaignLocation {
  id          String         @id @default(cuid())
  campaignId  String
  name        String
  description Json           @default("[]")
  sortOrder   Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  campaign    Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  notes       CampaignNote[]

  @@index([campaignId, name])
  @@index([campaignId, sortOrder])
}

model CampaignNote {
  id          String                   @id @default(cuid())
  campaignId  String
  locationId  String?
  title       String
  type        CampaignNoteType         @default(IMPORTANT_EVENT)
  summary     String                   @default("")
  content     String                   @default("")
  dmPrivate   Boolean                  @default(true)
  keywords    String[]                 @default([])
  occurredAt  DateTime?
  sortOrder   Int                      @default(0)
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  campaign    Campaign                 @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  location    CampaignLocation?        @relation(fields: [locationId], references: [id], onDelete: SetNull)
  players     CampaignNotePlayer[]
  attachments CampaignNoteAttachment[]
  triggers    CampaignNoteTrigger[]

  @@index([campaignId, type])
  @@index([campaignId, locationId])
  @@index([campaignId, occurredAt])
}

model CampaignNotePlayer {
  noteId   String
  playerId String
  note     CampaignNote @relation(fields: [noteId], references: [id], onDelete: Cascade)
  player   Player       @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@id([noteId, playerId])
  @@index([playerId])
}

model CampaignNoteAttachment {
  id        String                     @id @default(cuid())
  noteId    String
  type      CampaignNoteAttachmentType
  name      String
  details   String                     @default("")
  quantity  Int?
  metadata  Json                       @default("{}")
  createdAt DateTime                   @default(now())
  note      CampaignNote               @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([noteId, type])
}

model CampaignNoteTrigger {
  id              String                  @id @default(cuid())
  noteId          String
  type            CampaignNoteTriggerType
  label           String
  description     String                  @default("")
  checkType       String?
  difficultyClass Int?
  playerId        String?
  metadata        Json                    @default("{}")
  sortOrder       Int                     @default(0)
  createdAt       DateTime                @default(now())
  note            CampaignNote            @relation(fields: [noteId], references: [id], onDelete: Cascade)
  player          Player?                 @relation(fields: [playerId], references: [id], onDelete: SetNull)

  @@index([noteId, sortOrder])
  @@index([playerId])
  @@index([type])
}

model CharacterSheetRevision {
  id        String   @id @default(cuid())
  playerId  String
  summary   String   @default("")
  stats     Json
  equipment Json
  money     Json
  rolls     Json
  abilities Json
  createdAt DateTime @default(now())
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId, createdAt])
}

model KnowledgeDocument {
  id               String                  @id @default(cuid())
  campaignId       String
  sourceName       String
  sourceType       KnowledgeSourceType
  licenseText      String?
  attributionText  String?
  originalFileName String
  mimeType         String?
  importedAt       DateTime                @default(now())
  contentHash      String
  status           KnowledgeDocumentStatus @default(IMPORTED)
  errorMessage     String?
  indexedAt        DateTime?
  campaign         Campaign                @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  chunks           KnowledgeChunk[]

  @@unique([campaignId, contentHash])
  @@index([campaignId, sourceType])
}

model KnowledgeChunk {
  id           String                    @id @default(cuid())
  campaignId   String
  documentId   String
  sourceName   String
  sourceType   KnowledgeSourceType
  title        String
  sectionPath  String[]
  pageNumber   Int?
  chunkIndex   Int
  text         String
  textPreview  String
  hash         String
  embedding    Json?
  indexStatus  KnowledgeChunkIndexStatus @default(PENDING)
  errorMessage String?
  indexedAt    DateTime?
  createdAt    DateTime                  @default(now())
  campaign     Campaign                  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  document     KnowledgeDocument         @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([campaignId, hash])
  @@index([campaignId, sourceType])
  @@index([documentId, chunkIndex])
}
